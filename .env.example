# Copia questo file in .env e inserisci le tue credenziali reali

MQTT_BROKER=1.2.3.4
MQTT_PORT=1883
MQTT_TOPICS=mmdvm/+/json,p25-gateway/+/json,nxdn-gateway/+/json,dmr-gateway/+/json,dstar-gateway/+/json,ysf-gateway/+/json
MQTT_USER=user
MQTT_PASS=user_pwd
HTTP_PORT=7000
# Alert Telegram (nodo offline / tornato online). Vedi Telegram.txt
# TELEGRAM_BOT_TOKEN="TELEGRAM_BOT_TOKEN"
# TELEGRAM_CHAT_ID="TELEGRAM_CHAT_ID"
# NODE_TIMEOUT_HOURS=3
# WATCHDOG_INTERVAL_SEC=600

# Cronologia chiamate: 1 = conservata tra i riavvii (default 0 = svuotata all'avvio)
# KEEP_HISTORY=1
# RETENTION_DAYS=30
# Token per abilitare POST /clear (header X-Admin-Token). Se vuoto l endpoint e disabilitato
# ADMIN_TOKEN=cambia_questo_valore
